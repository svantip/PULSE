# Slack Configuration
# Get these from https://api.slack.com/apps

# Slack Bot Token (starts with xoxb-)
# Required for posting messages to Slack
SLACK_BOT_TOKEN=
# Slack Signing Secret
# Required for verifying requests from Slack
SLACK_SIGNING_SECRET=

# Slack Support Channel
# Channel where ticket analyses will be posted
# Can be channel ID (C0123456789) or name (support-tickets)
SLACK_SUPPORT_CHANNEL=support-channel

# Model Paths (optional)
# Leave empty to use default HuggingFace models
URGENCY_MODEL_PATH=
EMOTION_MODEL_PATH=
